        function renderSlide() {
            const slide = materiSlides[currentSlide];
            document.getElementById('slide-title-text').innerHTML = `<span>📖</span> ${slide.title}`;
            document.getElementById('slide-count-badge').innerText = `Slide ${currentSlide + 1} dari ${materiSlides.length}`;
            document.getElementById('slide-body').innerHTML = slide.content;

            // Render Dots
            const dotsContainer = document.getElementById('slide-dots');
            dotsContainer.innerHTML = '';
            materiSlides.forEach((_, idx) => {
                const dot = document.createElement('div');
                dot.style.width = idx === currentSlide ? '24px' : '10px';
                dot.style.height = '10px';
                dot.style.borderRadius = '10px';
                dot.style.background = idx === currentSlide ? '#F59E0B' : '#E5E7EB';
                dot.style.transition = 'all 0.3s ease';
                dotsContainer.appendChild(dot);
            });

            document.getElementById('prev-slide-btn').style.visibility = currentSlide === 0 ? 'hidden' : 'visible';
            document.getElementById('next-slide-btn').innerText = currentSlide === materiSlides.length - 1 ? 'Selesai 🏁' : 'Selanjutnya 👉';
        }

        function changeSlide(direction) {
            playSound('click');
            if (direction === 1 && currentSlide === materiSlides.length - 1) {
                switchTab('simulasi');
                return;
            }
            currentSlide += direction;
            if (currentSlide < 0) currentSlide = 0;
            if (currentSlide >= materiSlides.length) currentSlide = materiSlides.length - 1;
            renderSlide();
        }

        function updateSimulation() {
            const pribadi = parseInt(document.getElementById('slider-pribadi').value);
            const sedekah = parseInt(document.getElementById('slider-sedekah').value);
            const infaq = parseInt(document.getElementById('slider-infaq').value);

            const totalSpent = pribadi + sedekah + infaq;
            const remaining = 50000 - totalSpent;

            document.getElementById('val-pribadi').innerText = `Rp ${pribadi.toLocaleString('id-ID')}`;
            document.getElementById('val-sedekah').innerText = `Rp ${sedekah.toLocaleString('id-ID')}`;
            document.getElementById('val-infaq').innerText = `Rp ${infaq.toLocaleString('id-ID')}`;

            document.getElementById('sim-sisa-uang').innerText = `Rp ${remaining.toLocaleString('id-ID')}`;

            // Calculate Happiness and Blessing
            const totalGiving = sedekah + infaq;
            const happiness = Math.min(100, Math.round((totalGiving / 20000) * 60 + (pribadi > 0 ? 20 : 0)));
            const berkahMultiplier = (1 + (totalGiving / 10000) * 0.5).toFixed(1);

            document.getElementById('sim-kebahagiaan').innerText = `${happiness}%`;
            document.getElementById('sim-bar-bahagia').style.width = `${happiness}%`;
            document.getElementById('sim-berkah').innerText = `${berkahMultiplier}x`;

            const feedbackTitle = document.getElementById('sim-feedback-title');
            const feedbackText = document.getElementById('sim-feedback-text');

            if (remaining < 0) {
                feedbackTitle.innerText = "⚠️ Melebihi Anggaran Uang Saku!";
                feedbackText.innerText = "Pengeluaranmu melebihi uang saku yang dimiliki. Kurangi alokasi agar seimbang!";
            } else if (totalGiving >= 20000) {
                feedbackTitle.innerText = "🌟 Luar Biasa! Pemimpin yang Dermawan!";
                feedbackText.innerText = "Kamu mengalokasikan sebagian besar uang saku untuk bersedekah & infaq. Tanganmu berada di atas (pemberi) dan memancarkan keberkahan!";
            } else if (totalGiving > 0) {
                feedbackTitle.innerText = "👍 Pilihan Baik!";
                feedbackText.innerText = "Kamu sudah belajar berbagi. Semakin banyak bersedekah dengan ikhlas, semakin tenang dan berkah hartamu.";
            } else {
                feedbackTitle.innerText = "💭 Yuk Belajar Berbagi!";
                feedbackText.innerText = "Kamu menghabiskan seluruh uang saku untuk diri sendiri. Geser slider sedekah/infaq untuk merasakan nikmatnya memberi!";
            }
        }

        const quizBank = [
