        function startQuiz() {
            const nameInput = document.getElementById('student-name').value.trim();
            const classInput = document.getElementById('student-class').value;

            if (!nameInput || !classInput) {
                showCustomAlert('Data Belum Lengkap', 'Harap isi Nama Lengkap dan Pilih Kelas terlebih dahulu!');
                return;
            }

            studentInfo.name = nameInput;
            studentInfo.class = classInput;

            document.getElementById('quiz-reg-screen').style.display = 'none';
            document.getElementById('quiz-active-screen').style.display = 'block';
            document.getElementById('quiz-student-display').innerText = `Siswa: ${studentInfo.name} (${studentInfo.class})`;

            currentQuizIndex = 0;
            userAnswers = {};
            renderQuestion();
        }

        function renderQuestion() {
            const q = quizBank[currentQuizIndex];
            const container = document.getElementById('quiz-container');

            document.getElementById('quiz-progress-badge').innerText = `Soal ${currentQuizIndex + 1} dari ${quizBank.length}`;

            let html = `
                <div class="quiz-question-card">
                    <span class="question-number">Soal Tipe: ${q.type.toUpperCase()}</span>
                    <div class="question-text">${q.question}</div>
            `;

            if (q.type === 'pg' || q.type === 'bs') {
                html += `<div class="option-list">`;
                q.options.forEach((opt, idx) => {
                    const isSelected = userAnswers[q.id] === idx;
                    html += `
                        <div class="option-item ${isSelected ? 'selected' : ''}" onclick="selectSingleOption(${q.id}, ${idx})">
                            <input type="radio" name="q_${q.id}" ${isSelected ? 'checked' : ''}>
                            <span>${opt}</span>
                        </div>
                    `;
                });
                html += `</div>`;
            } else if (q.type === 'pgk') {
                const currentArr = userAnswers[q.id] || [];
                html += `<div class="option-list">`;
                q.options.forEach((opt, idx) => {
                    const isSelected = currentArr.includes(idx);
                    html += `
                        <div class="option-item ${isSelected ? 'selected' : ''}" onclick="toggleComplexOption(${q.id}, ${idx})">
                            <input type="checkbox" ${isSelected ? 'checked' : ''}>
                            <span>${opt}</span>
                        </div>
                    `;
                });
                html += `</div>`;
            } else if (q.type === 'matching') {
                const currentMap = userAnswers[q.id] || {};
                html += `
                    <p style="font-size:0.85rem; color:#B45309; margin-bottom:10px;">Klik item di kiri, lalu klik pasangannya di kanan!</p>
                    <div class="matching-grid">
                        <div class="matching-column">
                            <h5 style="text-align:center; color:#1F2937;">Sisi Kiri</h5>
                `;
                q.leftItems.forEach((item, lIdx) => {
                    const isMatched = currentMap[lIdx] !== undefined;
                    const isSelected = matchingSelection.left === lIdx;
                    html += `
                        <div class="match-card ${isMatched ? 'matched' : ''} ${isSelected ? 'selected-left' : ''}" 
                             onclick="selectMatchingLeft(${lIdx})">
                            ${item} ${isMatched ? '✓' : ''}
                        </div>
                    `;
                });
                html += `</div><div class="matching-column"><h5 style="text-align:center; color:#1F2937;">Sisi Kanan</h5>`;
                q.rightItems.forEach((item, rIdx) => {
                    const matchedLeft = Object.keys(currentMap).find(key => currentMap[key] === rIdx);
                    html += `
                        <div class="match-card ${matchedLeft !== undefined ? 'matched' : ''}" 
                             onclick="selectMatchingRight(${rIdx})">
                            ${item}
                        </div>
                    `;
                });
                html += `</div></div>`;
            }

            html += `</div>`;
            container.innerHTML = html;

            document.getElementById('btn-prev-q').style.visibility = currentQuizIndex === 0 ? 'hidden' : 'visible';
            if (currentQuizIndex === quizBank.length - 1) {
                document.getElementById('btn-next-q').style.display = 'none';
                document.getElementById('btn-submit-q').style.display = 'inline-flex';
            } else {
                document.getElementById('btn-next-q').style.display = 'inline-flex';
                document.getElementById('btn-submit-q').style.display = 'none';
            }
        }

        function selectSingleOption(qId, optionIdx) {
            playSound('click');
            userAnswers[qId] = optionIdx;
            renderQuestion();
        }

        function toggleComplexOption(qId, optionIdx) {
            playSound('click');
            if (!userAnswers[qId]) userAnswers[qId] = [];
            const arr = userAnswers[qId];
            const pos = arr.indexOf(optionIdx);
            if (pos > -1) {
                arr.splice(pos, 1);
            } else {
                arr.push(optionIdx);
            }
            renderQuestion();
        }

        function selectMatchingLeft(leftIdx) {
            playSound('click');
            matchingSelection.left = leftIdx;
            renderQuestion();
        }

        function selectMatchingRight(rightIdx) {
            if (matchingSelection.left === null) {
                showCustomAlert('Petunjuk', 'Klik item di sebelah kiri terlebih dahulu!');
                return;
            }
            playSound('click');
            const q = quizBank[currentQuizIndex];
            if (!userAnswers[q.id]) userAnswers[q.id] = {};
            userAnswers[q.id][matchingSelection.left] = rightIdx;
            matchingSelection.left = null;
            renderQuestion();
        }

        function navigateQuestion(direction) {
            playSound('click');
            currentQuizIndex += direction;
            matchingSelection.left = null;
            renderQuestion();
        }

        function finishQuiz() {
            playSound('success');
            let totalScore = 0;
            let correctCount = 0;
            let incorrectCount = 0;
            let formattedAnswersLog = [];

            quizBank.forEach((q, idx) => {
                let isCorrect = false;
                const ans = userAnswers[q.id];
                let userAnsText = "-";

                if (q.type === 'pg' || q.type === 'bs') {
                    if (ans !== undefined) {
                        userAnsText = q.options[ans];
                    }
                    if (ans === q.correct) isCorrect = true;
                } else if (q.type === 'pgk') {
                    if (ans && Array.isArray(ans) && ans.length > 0) {
                        userAnsText = ans.map(i => q.options[i]).join('; ');
                        isCorrect = q.correct.length === ans.length && q.correct.every(val => ans.includes(val));
                    }
                } else if (q.type === 'matching') {
                    if (ans && typeof ans === 'object' && Object.keys(ans).length > 0) {
                        let pairs = [];
                        let c = 0;
                        Object.keys(ans).forEach(k => {
                            pairs.push(`${q.leftItems[k]} ➔ ${q.rightItems[ans[k]]}`);
                            if (ans[k] === q.correctMap[k]) c++;
                        });
                        userAnsText = pairs.join(' | ');
                        if (c === Object.keys(q.correctMap).length) isCorrect = true;
                    }
                }

                if (isCorrect) {
                    totalScore += 10;
                    correctCount++;
                } else {
                    incorrectCount++;
                }

                formattedAnswersLog.push(`[Soal ${idx + 1}] (${isCorrect ? 'BENAR' : 'SALAH'}): ${userAnsText}`);
            });

            document.getElementById('quiz-active-screen').style.display = 'none';
            document.getElementById('quiz-result-screen').style.display = 'block';

            document.getElementById('result-student-info').innerText = `Nama: ${studentInfo.name} | Kelas: ${studentInfo.class}`;
            document.getElementById('result-score').innerText = totalScore;

            let predikat = '';
            if (totalScore >= 90) predikat = 'Sangat Baik (Mumtaz) 🎉';
            else if (totalScore >= 75) predikat = 'Baik (Jayyid) 👍';
            else if (totalScore >= 60) predikat = 'Cukup (Maqbul) 👌';
            else predikat = 'Perlu Belajar Lagi 💪';

            document.getElementById('result-predikat').innerText = `Predikat: ${predikat}`;

            // Generate Detailed Review Breakdown
            const reviewContainer = document.getElementById('quiz-review-list');
            reviewContainer.innerHTML = '';

            quizBank.forEach((q, idx) => {
                let isCorrect = false;
                const ans = userAnswers[q.id];

                if (q.type === 'pg' || q.type === 'bs') {
                    isCorrect = ans === q.correct;
                } else if (q.type === 'pgk') {
                    isCorrect = ans && Array.isArray(ans) && q.correct.length === ans.length && q.correct.every(val => ans.includes(val));
                } else if (q.type === 'matching') {
                    if (ans) {
                        let c = 0;
                        Object.keys(q.correctMap).forEach(k => { if (ans[k] === q.correctMap[k]) c++; });
                        isCorrect = c === Object.keys(q.correctMap).length;
                    }
                }

                const card = document.createElement('div');
                card.className = `review-card ${isCorrect ? 'correct' : 'incorrect'}`;
                card.innerHTML = `
                    <div style="font-weight:800; color:${isCorrect ? '#059669' : '#DC2626'}; margin-bottom:6px;">
                        ${isCorrect ? '✅ Benar' : '❌ Salah / Belum Tepat'} - Soal ${idx + 1}
                    </div>
                    <div style="font-weight:700; margin-bottom:8px;">${q.question}</div>
                    <div class="pembahasan-box">
                        <strong>💡 Pembahasan:</strong> ${q.explanation}
                    </div>
                `;
                reviewContainer.appendChild(card);
            });

            // Kirim Hasil ke Database Google Apps Script
            sendDataToGoogleSheet({
                nama: studentInfo.name,
                kelas: studentInfo.class,
                waktuPengerjaan: new Date().toLocaleString('id-ID'),
                skorTotal: totalScore,
                predikat: predikat,
                jumlahBenar: correctCount,
                jumlahSalah: incorrectCount,
                rincianJawaban: formattedAnswersLog.join('\n'),
                questions: quizBank
            });
        }

        function sendDataToGoogleSheet(payload) {
            const statusBadge = document.getElementById('db-save-status-badge');
            statusBadge.style.background = '#EFF6FF';
            statusBadge.style.color = '#1E40AF';
            statusBadge.innerHTML = '<span>⏳ Menyimpan hasil ke database...</span>';

            if (!SCRIPT_URL || SCRIPT_URL === 'YOUR_GOOGLE_APPS_SCRIPT_WEB_APP_URL') {
                statusBadge.style.background = '#FEF2F2';
                statusBadge.style.color = '#991B1B';
                statusBadge.innerHTML = '<span>⚠️ Database belum dihubungkan (URL Web App belum diisi).</span>';
                return;
            }

            fetch(SCRIPT_URL, {
                method: 'POST',
                mode: 'no-cors',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(payload)
            })
            .then(() => {
                statusBadge.style.background = '#ECFDF5';
                statusBadge.style.color = '#065F46';
                statusBadge.innerHTML = '<span>✅ Hasil berhasil disimpan ke database guru!</span>';
            })
            .catch(err => {
                console.error('Error saving:', err);
                statusBadge.style.background = '#FEF2F2';
                statusBadge.style.color = '#991B1B';
                statusBadge.innerHTML = '<span>❌ Gagal menyimpan ke database (Periksa koneksi).</span>';
            });
        }

        function resetQuiz() {
            playSound('click');
            document.getElementById('quiz-result-screen').style.display = 'none';
            document.getElementById('quiz-reg-screen').style.display = 'block';
            document.getElementById('student-name').value = '';
        }

        window.onload = function() {
            renderSlide();
            updateSimulation();
        };
    </script>
